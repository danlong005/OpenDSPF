**FREE

// Test 07: field validation keywords (VALUES/RANGE/COMP)

RECORD TESTREC
  SCREEN SIZE(24 80)

  LITERAL  ROW(1)  COL(2)  'Validation Test'
  FIELD GENDER  CHAR(1)     INPUT  ROW(3)  COL(10)  VALUES('M' 'F')
  FIELD AGE     ZONED(3:0)  INPUT  ROW(4)  COL(10)  RANGE(0 120)
  FIELD SCORE   ZONED(3:0)  INPUT  ROW(5)  COL(10)  COMP(GE 0)

  KEY F3  INDICATOR(03)
END-RECORD
