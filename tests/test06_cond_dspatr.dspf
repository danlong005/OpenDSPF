**FREE

RECORD ORDENTRY
  SCREEN SIZE(24 80)
  TITLE 'Order Entry'

  LITERAL  ROW(1)  COL(30)  'ORDER ENTRY'
  LITERAL  ROW(3)  COL(2)   'Order No:'
  LITERAL  ROW(5)  COL(2)   'Amount:'

  FIELD ORDNO  CHAR(8)   BOTH  ROW(3) COL(12) COND(N*IN99)
  FIELD ORDNO  CHAR(8)   BOTH  ROW(3) COL(12) DSPATR(RI) COND(*IN99)
  FIELD AMOUNT ZONED(9:2) OUTPUT ROW(5) COL(10)

  LITERAL  ROW(24) COL(2)  'F3=Exit'
  KEY F3  INDICATOR(03)
END-RECORD
